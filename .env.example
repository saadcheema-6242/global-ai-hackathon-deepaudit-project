# ============================================================
# DeepAudit AI — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your API keys.
# The app works in DEMO MODE without real keys (smart simulation).

# Tavily Search API Key (https://tavily.com)
# Get your free API key at: https://app.tavily.com/sign-in
TAVILY_API_KEY=demo

# ── LLM gateway / provider (claim extraction) ──
# Any OpenAI-compatible /chat/completions endpoint works. Leave as "demo"
# to run local simulation (no key, no cost).
BIFROST_API_KEY=demo
BIFROST_GATEWAY_URL=https://api.getmaxim.ai/v1/chat/completions

# Model names (optional). Defaults to OpenAI gpt-4o / gpt-4o-mini.
# Set these to match your provider when NOT using OpenAI.
#   BIFROST_MODEL       = model for complex/high-risk prompts
#   BIFROST_MODEL_FAST  = cheap model for simple prompts (falls back to BIFROST_MODEL)
# BIFROST_MODEL=gpt-4o
# BIFROST_MODEL_FAST=gpt-4o-mini

# ── Provider quick-configs (pick one, copy into .env.local) ──
#
# Groq (free, fast, natively OpenAI-compatible):
#   BIFROST_API_KEY=gsk_...
#   BIFROST_GATEWAY_URL=https://api.groq.com/openai/v1/chat/completions
#   BIFROST_MODEL=llama-3.3-70b-versatile
#   BIFROST_MODEL_FAST=llama-3.1-8b-instant
#
# Google Gemini (via its OpenAI-compatibility endpoint):
#   BIFROST_API_KEY=AIza...
#   BIFROST_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   BIFROST_MODEL=gemini-2.5-flash
#   BIFROST_MODEL_FAST=gemini-2.5-flash
#
# Self-hosted Bifrost gateway (multi-provider load balancing):
#   BIFROST_API_KEY=your-bifrost-key
#   BIFROST_GATEWAY_URL=http://your-host:PORT/v1/chat/completions
